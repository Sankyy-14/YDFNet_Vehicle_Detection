# checkpoints/*.pt

# Stale/leftover checkpoints from earlier test runs — never needed
checkpoints/ydfnet_epoch13.pt
checkpoints/ydfnet_epoch14.pt
checkpoints/ydfnet_epoch15.pt

# Ultralytics YOLO video/image inference outputs (large, regenerable)
runs/

# Real dataset — NEVER commit this (10GB+, also not yours to redistribute —
# UA-DETRAC has its own license/access terms)
UA-DETRAC/
*.jpg
*.jpeg
!samples/*.png
!label_check.png

